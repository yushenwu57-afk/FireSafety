  m_GameObject: {fileID: 551020524}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f9f977134a38f7640ba4fff4a0af1ecd, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  interactableObject: {fileID: 551020531}
  decisionManager: {fileID: 107813977}
  decisionTitle: Pan Fire
  decisionDescription: A pan on the stove has caught fire. What should you do first?
  optionA: Turn off the stove
  optionB: Pour water onto the fire
  optionC: Use a fire blanket
  optionAOutcome:
    feedbackTitle: Heat Source Removed
    feedbackDescription: "You turn off the stove. The heat source is \nremoved, but
      the burning pan still needs to be\ndealt with.\n"
    changeDangerLevel: 1
    targetDangerLevel: 0
    fireCommand: 0
    smokeCommand: 0
    changeScenarioPhase: 1
    targetScenarioPhase: 6
  optionBOutcome:
    feedbackTitle: Fire Flare-Up
    feedbackDescription: "The water causes the burning oil to\n flare violently,
      making the situation much\nmore dangerous."
    changeDangerLevel: 1
    targetDangerLevel: 2
    fireCommand: 1
    smokeCommand: 1
    changeScenarioPhase: 1
    targetScenarioPhase: 3
  optionCOutcome:
    feedbackTitle: Fire Smothered
    feedbackDescription: 'You carefully use the fire blanket to smother

      the
      flames.'
    changeDangerLevel: 1
    targetDangerLevel: 0
    fireCommand: 2
    smokeCommand: 2
    changeScenarioPhase: 1
    targetScenarioPhase: 4
