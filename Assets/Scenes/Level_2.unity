--- !u!114 &107813987
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 107813974}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e132ae18249fa0148847233f4717293e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  scenarioManager: {fileID: 107813978}
  decisionManager: {fileID: 107813977}
  stabilisingDecision:
    decisionTitle: The Fire Is Still Burning
    decisionDescription: "The stove is off, but flames are still \ncoming from the
      pan. What should you do next?"
    optionA: Slide a lid over the pan
    optionB: Carry the burning pan to the sink
    optionC: Use a fire blanket
    optionAOutcome:
      feedbackTitle: Fire Smothered
      feedbackDescription: "You cover the pan with a lid, cutting \noff the oxygen
        supply and smothering the\nflames.\n"
      changeDangerLevel: 1
      targetDangerLevel: 0
      fireCommand: 2
      smokeCommand: 2
      changeScenarioPhase: 1
      targetScenarioPhase: 4
    optionBOutcome:
      feedbackTitle: Unsafe Movement
      feedbackDescription: "Moving a pan of burning oil risks spilling the \ncontents
        and spreading the fire."
      changeDangerLevel: 1
      targetDangerLevel: 2
      fireCommand: 1
      smokeCommand: 1
      changeScenarioPhase: 1
      targetScenarioPhase: 3
    optionCOutcome:
      feedbackTitle: Fire Smothered
      feedbackDescription: You carefully place the fire blanket over the pan and
        smother the flames.
      changeDangerLevel: 1
      targetDangerLevel: 0
      fireCommand: 2
      smokeCommand: 2
      changeScenarioPhase: 1
      targetScenarioPhase: 4
  escalatingDecision:
    decisionTitle: The Fire Has Escalated
    decisionDescription: "The flames have intensified and the \nkitchen is no longer
      safe to approach. What \nshould you do?"
    optionA: Leave the kitchen, close the door and call 000
    optionB: Keep trying to fight the fire
    optionC: Go back for personal belongings
    optionAOutcome:
      feedbackTitle: Safe Evacuation
      feedbackDescription: "You leave the dangerous area, close the \ndoor behind
        you and call Triple Zero (000) \nfrom a safe place."
      changeDangerLevel: 0
      targetDangerLevel: 0
      fireCommand: 0
      smokeCommand: 0
      changeScenarioPhase: 1
      targetScenarioPhase: 4
    optionBOutcome:
      feedbackTitle: Too Dangerous
      feedbackDescription: "The fire is now too large to fight safely. \nStaying
        close to it puts you at greater risk."
      changeDangerLevel: 1
      targetDangerLevel: 2
      fireCommand: 1
      smokeCommand: 1
      changeScenarioPhase: 1
      targetScenarioPhase: 5
    optionCOutcome:
      feedbackTitle: Unsafe Delay
      feedbackDescription: 'Returning for belongings delays evacuation

        and
        keeps you close to the escalating fire.'
      changeDangerLevel: 1
      targetDangerLevel: 2
      fireCommand: 1
      smokeCommand: 1
      changeScenarioPhase: 1
      targetScenarioPhase: 5
  recoveryDecision:
    decisionTitle: Get Help
    decisionDescription: 'You have moved away from the immediate danger.

      What
      should you do now?'
    optionA: Call Triple Zero (000) from a safe place
    optionB: Go back inside to check the fire
    optionC: Wait nearby and see if the fire dies down
    optionAOutcome:
      feedbackTitle: Emergency Services Contacted
      feedbackDescription: You call Triple Zero from a safe location and report
      changeDangerLevel: 0
      targetDangerLevel: 0
      fireCommand: 0
      smokeCommand: 0
      changeScenarioPhase: 1
      targetScenarioPhase: 4
    optionBOutcome:
      feedbackTitle: Option B Outcome
      feedbackDescription: "Re-entering the area exposes you \nagain to the escalating\nfire
        and smoke."
      changeDangerLevel: 1
      targetDangerLevel: 2
      fireCommand: 1
      smokeCommand: 1
      changeScenarioPhase: 1
      targetScenarioPhase: 5
    optionCOutcome:
      feedbackTitle: Dangerous Delay
      feedbackDescription: "Waiting without contacting emergency \nservices delays\nthe
        response while the fire continues to develop."
      changeDangerLevel: 1
      targetDangerLevel: 2
      fireCommand: 1
      smokeCommand: 1
      changeScenarioPhase: 1
      targetScenarioPhase: 5
